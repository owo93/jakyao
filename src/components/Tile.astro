---
const { value, unit, length = 2 } = Astro.props;
const digits = value.toString().padStart(length, "0").split("");
---

<div class="flex items-center gap-2 sm:flex-col sm:items-center">
  <span class="font-mono text-xs opacity-60 sm:text-sm">
    {unit.toUpperCase()}
  </span>

  <div class="flex gap-1">
    {
      digits.map((d: string) => (
        <tile-cell class="flex items-center justify-center rounded-md border-4 border-double border-neutral-300 bg-neutral-100 p-3 font-mono text-lg transition-colors duration-350 hover:bg-neutral-700 sm:text-xl dark:border-neutral-700 dark:bg-neutral-900">
          {d}
        </tile-cell>
      ))
    }
  </div>
</div>

<script define:vars={{ value, length }}>
  const CHARSET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+{}";

  class TileCell extends HTMLElement {
    _interval = null;
    scrambleTo(value) {
      if (this._interval) {
        clearInterval(this._interval);
        this._interval = null;
      }

      let elapsed = 0;
      const duration = 1000;
      const intervalMs = 50;

      this._interval = setInterval(() => {
        elapsed += intervalMs;

        if (elapsed >= duration) {
          clearInterval(this._interval);
          this._interval = null;
          this.textContent = value;
          this.style.borderColor = "";
          return;
        }

        this.textContent = CHARSET[Math.floor(Math.random() * CHARSET.length)];
        this.style.borderColor = `hsl(${Math.random() * -180} 80% 67%)`;
      }, intervalMs);
    }
  }

  // register once
  if (!customElements.get("title-cell")) {
    customElements.define("tile-cell", TileCell);
  }
</script>
